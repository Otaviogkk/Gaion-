from flask import Flask, make_response, jsonify, request
from terrenos import imoveis

app = Flask('_name_')
app.config['JSON_SORT_KEYS']= False

@app.route('/imoveis', methods=['GET'])
def get_imoveis():
    return make_response(jsonify(mensagem = "Lista de imóveis", dados=imoveis))

def create_imovel():
    imovel = request.json
    imoveis.append(imovel)
    return make_response(
        jsonify(mensagem="imóvel cadastrado com sucesso!", imovel))

app.run()
